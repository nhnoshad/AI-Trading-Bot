{
  "manifest_version": 3,
  "name": "AI Trading Signal Bot (Quotex & Market-QX)",
  "version": "1.1.0",
  "description": "AI-powered BUY/SELL/WAIT signal scanner for https://market-qx.info/en/demo-trade and Quotex with live pair switching detection",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://market-qx.info/*",
    "https://*.market-qx.info/*",
    "https://qxbroker.com/*",
    "https://*.qxbroker.com/*",
    "https://quotex.com/*",
    "https://*.quotex.com/*",
    "https://*.quotex.io/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://market-qx.info/*",
        "https://*.market-qx.info/*",
        "https://qxbroker.com/*",
        "https://*.qxbroker.com/*",
        "https://quotex.com/*",
        "https://*.quotex.com/*",
        "https://*.quotex.io/*"
      ],
      "js": ["src/scripts/ws_hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://market-qx.info/*",
        "https://*.market-qx.info/*",
        "https://qxbroker.com/*",
        "https://*.qxbroker.com/*",
        "https://quotex.com/*",
        "https://*.quotex.com/*",
        "https://*.quotex.io/*"
      ],
      "js": ["src/scripts/content.js"],
      "css": ["src/overlay/overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/scripts/ws_hook.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "src/assets/icon16.png",
      "48": "src/assets/icon48.png",
      "128": "src/assets/icon128.png"
    },
    "default_title": "AI Trading Signal Bot - Scan Market-QX"
  },
  "icons": {
    "16": "src/assets/icon16.png",
    "48": "src/assets/icon48.png",
    "128": "src/assets/icon128.png"
  }
}
